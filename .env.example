#############################################
# Supabase (coleta de leads e respostas)
#############################################

# Public (Project URL em Settings → API)
SUPABASE_URL=

# Server-side only (Secret key em API Keys; NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Opcional (Publishable key; só se for usar Supabase direto no client + RLS)
SUPABASE_ANON_KEY=

# Migração two-phase (lead ao iniciar quiz + respostas ao fim): ver sql/quiz_submissions_two_phase.sql

#############################################
# Admin — alunos e pagamentos (/admin)
#############################################

# Chave de acesso do painel /admin.
# Use algo longo e aleatório. Acesso: /admin?secret=SUA_CHAVE
# (se não existir, cai no DASHBOARD_SECRET antigo)
ADMIN_SECRET=

# ID exclusivo do produto presencial de 18/10/2026 na Cakto.
# Sem este ID, a barra fica na base de 15%, aguardando integração.
CAKTO_PRODUTO_PRESENCIAL_OUTUBRO_2026=

# Tabelas: rode sql/admin_alunos_pagamentos.sql no SQL Editor do Supabase.
